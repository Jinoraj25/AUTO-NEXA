# Ignore executables
*.exe

# Ignore Python caches
__pycache__/
*.pyc

# Ignore SQLite DBs
*.db
*.db-*

# Ignore raw dataset files & archives
*.xls
*.xlsx
*.xlsb
*.csv
ALL GOOD STOCK/
uploaded_data_archive/
scratch/

# Ignore large uncompressed JSON files (we deploy .json.gz versions)
*.json
data/*.json

# Keep dataset files required by server and UI
!sales_cache.json.gz
!data/sales_cache.json.gz
!stock_cache.json.gz
!data/stock_cache.json.gz
!trained_mapping_db.json.gz
!data/trained_mapping_db.json.gz
!aggregate_master_rules.json.gz
!data/aggregate_master_rules.json.gz
# Ignore temporary screenshot and test scratch files
shot_*.png
test_*.html
test_*.py
